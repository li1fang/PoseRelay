{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Live2D Blink Event v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "type", "instanceId", "eventId", "atMs"],
  "properties": {
    "version": {"const": 1},
    "type": {"enum": ["blink.once", "blink.auto"]},
    "instanceId": {"type": "string", "minLength": 1, "maxLength": 128},
    "eventId": {"type": "string", "minLength": 1, "maxLength": 128},
    "atMs": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
    "enabled": {"type": "boolean"}
  },
  "if": {"properties": {"type": {"const": "blink.auto"}}},
  "then": {"required": ["enabled"]},
  "else": {"not": {"required": ["enabled"]}}
}
